root=true

[*.{css,html,json,md,s{h,vg},txt,v{cf,tt},yml},.{{editor,git}config,git{attributes,ignore},htaccess,shellcheckrc}]
insert_final_newline=true
indent_style=space
charset=utf-8

[*.{css,html,json,md,s{h,vg},txt,vtt,yml},.{{editor,git}config,git{attributes,ignore},htaccess,shellcheckrc}]
end_of_line=lf

[*.{css,html,json,md,s{h,vg},txt,yml},.{{editor,git}config,git{attributes,ignore},htaccess,shellcheckrc}]
indent_size=2

[*.v{cf,tt}]
indent_size=0

[*.vcf]
end_of_line=crlf
